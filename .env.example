# ─── Base de datos (datawarehouse único, SQLite) ───────────────────────
# Local en tu PC:
DATABASE_URL=file:data/empresa.db
# En la nube (Turso, gratis) para que trabajen con el PC apagado:
# DATABASE_URL=libsql://giraffora-<tu-usuario>.turso.io
# DATABASE_AUTH_TOKEN=

# ─── Cerebros IA (pon al menos uno; se usan en este orden de respaldo) ─
# Gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gratis: https://console.groq.com/keys
GROQ_API_KEY=
# Opcional (pago por uso, mejor calidad para redacción/estrategia)
ANTHROPIC_API_KEY=
# Modelo por defecto "proveedor:modelo"
DEFAULT_MODEL=gemini:gemini-flash-latest

# ─── Herramientas (opcionales, todas con plan gratis) ──────────────────
# Búsqueda web: https://tavily.com (1.000/mes gratis). Sin clave usa DuckDuckGo.
TAVILY_API_KEY=
# Mercado Público: pide tu ticket gratis en https://api.mercadopublico.cl
MERCADO_PUBLICO_TICKET=

# ─── n8n (conectores) ───────────────────────────────────────────────────
# n8n envía correos/WhatsApp/calendario a /api/ingest con este secreto
INGEST_SECRET=cambia-esto
# Webhook de n8n que ejecuta los mensajes que TÚ apruebas en la Bandeja
N8N_OUTBOX_WEBHOOK=

# ─── Correo (secretario + newsletter) ─────────────────────────────────
# Por cuenta: contraseña de aplicación de Google (myaccount.google.com/apppasswords, requiere verificación en 2 pasos)
MAIL_1_LABEL=personal
MAIL_1_USER=
MAIL_1_PASS=
MAIL_2_LABEL=profesional
MAIL_2_USER=
MAIL_2_PASS=
MAIL_3_LABEL=giraffora
MAIL_3_USER=
MAIL_3_PASS=
# Firma opcional por cuenta (\n = salto de línea)
MAIL_3_FIRMA=Danko\nGiraffora
# Cuenta desde la que salen los newsletters (su LABEL)
MAIL_ENVIOS=giraffora
# Correos masivos por turno (Workspace permite ~2.000/día)
MAX_EMAILS_PER_RUN=400
# URL pública de la app (Vercel) para el link de baja con un clic
APP_URL=

# ─── App ────────────────────────────────────────────────────────────────
# Contraseña para entrar (déjala vacía solo en tu PC)
APP_PASSWORD=
# Hora de Chile en que se arma el brief (6 = listo antes de las 7)
BRIEF_HOUR=6
# Tareas por turno: de día y de noche (00-06)
MAX_TASKS_PER_RUN=4
MAX_TASKS_NIGHT=10

# ─── Archivos en tu PC ──────────────────────────────────────────────────
# Carpeta donde quedan las entregas y tus archivos (por defecto ./Archivos)
FILES_DIR=
# Minutos máximos por trabajo de Claude Code (videos largos)
CLAUDE_TIMEOUT_MIN=60
